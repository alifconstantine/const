{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@const/chord": ["./packages/chord/src/index.ts"],
			"@const/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@const/chord/context": ["./packages/chord/src/context/index.ts"],
			"@const/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@const/chord/node": ["./packages/chord/src/node.ts"],
			"@earendil-works/chord": ["./packages/chord/src/index.ts"],
			"@earendil-works/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@earendil-works/chord/context": ["./packages/chord/src/context/index.ts"],
			"@earendil-works/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@earendil-works/chord/node": ["./packages/chord/src/node.ts"],

			"@const/telemetry": ["./packages/telemetry/src/index.ts"],
			"@const/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@earendil-works/pi-telemetry": ["./packages/telemetry/src/index.ts"],
			"@earendil-works/pi-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],

			"@const/ai": ["./packages/ai/src/index.ts"],
			"@const/ai/compat": ["./packages/ai/src/compat.ts"],
			"@const/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@const/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@const/ai/dist/*": ["./packages/ai/src/*"],
			"@earendil-works/pi-ai": ["./packages/ai/src/index.ts"],
			"@earendil-works/pi-ai/compat": ["./packages/ai/src/compat.ts"],
			"@earendil-works/pi-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@earendil-works/pi-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@earendil-works/pi-ai/dist/*": ["./packages/ai/src/*"],

			"@const/agent": ["./packages/agent/src/index.ts"],
			"@const/agent/harness/session/testing": ["./packages/agent/src/harness/session/testing/index.ts"],
			"@const/agent/node": ["./packages/agent/src/node.ts"],
			"@const/agent/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@earendil-works/pi-agent-core": ["./packages/agent/src/index.ts"],
			"@earendil-works/pi-agent-core/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@earendil-works/pi-agent-core/node": ["./packages/agent/src/node.ts"],
			"@earendil-works/pi-agent-core/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],

			"@const/session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@earendil-works/pi-session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],

			"@const/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@const/coding-agent/experimental/plugin": ["./packages/coding-agent/src/experimental/plugin.ts"],
			"@const/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@const/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@earendil-works/pi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@earendil-works/pi-coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@earendil-works/pi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@earendil-works/pi-coding-agent/*": ["./packages/coding-agent/src/*"],

			"@const/protocol": ["./packages/protocol/src/index.ts"],
			"@const/protocol/*": ["./packages/protocol/src/*"],
			"@earendil-works/pi-protocol": ["./packages/protocol/src/index.ts"],
			"@earendil-works/pi-protocol/*": ["./packages/protocol/src/*"],

			"@const/client": ["./packages/client/src/index.ts"],
			"@const/client/unix": ["./packages/client/src/unix.ts"],
			"@const/client/*": ["./packages/client/src/*"],
			"@earendil-works/pi-client": ["./packages/client/src/index.ts"],
			"@earendil-works/pi-client/unix": ["./packages/client/src/unix.ts"],
			"@earendil-works/pi-client/*": ["./packages/client/src/*"],

			"@const/server": ["./packages/server/src/index.ts"],
			"@const/server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@const/server/*": ["./packages/server/src/*"],
			"@earendil-works/pi-server": ["./packages/server/src/index.ts"],
			"@earendil-works/pi-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@earendil-works/pi-server/*": ["./packages/server/src/*"],

			"typebox": ["./node_modules/typebox"],

			"@const/tui": ["./packages/tui/src/index.ts"],
			"@const/tui/*": ["./packages/tui/src/*"],
			"@earendil-works/pi-tui": ["./packages/tui/src/index.ts"],
			"@earendil-works/pi-tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/session-backends/*/src/**/*",
		"packages/session-backends/*/test/**/*"
	],
	"exclude": ["**/dist/**", "node_modules"]
}
