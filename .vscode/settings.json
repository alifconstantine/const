{
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/dist-electron": true,
    "**/release": true,
    "**/*.tsbuildinfo": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/release/**": true
  },
  "java.configuration.updateBuildConfiguration": "interactive",
  "java.import.gradle.wrapper.enabled": true
}
