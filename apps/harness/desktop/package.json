{
  "name": "@const/harness-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check-types": "tsc --noEmit",
    "package:win": "tsc && vite build && electron-builder --win --x64 --arm64",
    "package:win:x64": "tsc && vite build && electron-builder --win --x64",
    "package:win:arm64": "tsc && vite build && electron-builder --win --arm64",
    "package:linux": "tsc && vite build && electron-builder --linux AppImage pacman",
    "package:linux:appimage": "tsc && vite build && electron-builder --linux AppImage",
    "package:linux:pacman": "tsc && vite build && electron-builder --linux pacman"
  },
  "dependencies": {
    "@const/agent": "workspace:*",
    "@const/backend": "workspace:*",
    "@const/ui": "workspace:*",
    "@iconify/react": "^6.0.2",
    "@thesvg/react": "^3.3.13",
    "@types/marked": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "convex": "^1.45.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "marked": "18.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@const/typescript-config": "workspace:*",
    "@iconify-json/vscode-icons": "^1.2.76",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "id.web.const.harness.desktop",
    "productName": "Const Harness",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development"
    }
  }
}
