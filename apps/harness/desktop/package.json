{
  "name": "@const/harness-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/build-computer-use-macos.cjs && node scripts/copy-excalidraw-assets.cjs && vite",
    "build": "node scripts/build-computer-use-macos.cjs && node scripts/copy-excalidraw-assets.cjs && tsc && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "check-types": "tsc --noEmit",
    "test:skills": "tsx --test electron/skill-installer.test.ts",
    "test:mcp": "tsx --test --test-concurrency=1 electron/mcp/*.test.ts",
    "test:plugins:preview": "node scripts/copy-excalidraw-assets.cjs && vite --config tests/vite.config.ts --port 5190",
    "test:models": "tsx --test src/lib/models.test.ts",
    "test:markdown": "tsx --test src/components/workbench/*.test.ts",
    "test:remote": "tsx --test electron/remote-daemon.test.ts",
    "test:startup": "node scripts/test-startup.cjs",
    "test:remote:preview": "vite --config tests/remote-mobile.vite.ts",
    "test:telemetry": "tsx --test src/lib/chat-telemetry.test.ts electron/chat-telemetry.test.ts",
    "test:side-chat": "node scripts/test-side-chat.cjs",
    "test:window-branding": "node scripts/test-window-branding.cjs",
    "test:browser": "node scripts/test-browser.cjs",
    "test:intelligence-ui": "tsx --test src/components/intelligence-ui/*.test.ts",
    "test:intelligence-ui:preview": "vite --config tests/vite.config.ts",
    "test:intelligence-ui:live": "tsx tests/intelligence-ui.live.ts",
    "package:win": "node scripts/copy-excalidraw-assets.cjs && tsc && vite build && electron-builder --win --x64 --arm64",
    "package:win:x64": "node scripts/copy-excalidraw-assets.cjs && tsc && vite build && electron-builder --win --x64",
    "package:win:arm64": "node scripts/copy-excalidraw-assets.cjs && tsc && vite build && electron-builder --win --arm64",
    "package:linux": "node scripts/copy-excalidraw-assets.cjs && tsc && vite build && electron-builder --linux AppImage pacman",
    "package:linux:appimage": "node scripts/copy-excalidraw-assets.cjs && tsc && vite build && electron-builder --linux AppImage",
    "package:linux:pacman": "node scripts/copy-excalidraw-assets.cjs && tsc && vite build && electron-builder --linux pacman",
    "build:native": "node scripts/build-computer-use-macos.cjs",
    "package:mac": "node scripts/copy-excalidraw-assets.cjs && tsc && vite build && electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@const/remote": "workspace:*",
    "@const/agent": "workspace:*",
    "@const/backend": "workspace:*",
    "@const/ui": "workspace:*",
    "@excalidraw/excalidraw": "0.18.0",
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@thesvg/react": "^3.3.13",
    "@types/marked": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "convex": "^1.45.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "marked": "18.0.5",
    "mermaid": "^12.2.0",
    "motion": "^13.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@const/typescript-config": "workspace:*",
    "@iconify-json/vscode-icons": "^1.2.76",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.20.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "id.web.const.harness.desktop",
    "productName": "Const Harness",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "branding",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      },
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*",
          "!computer-use-macos/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development"
    },
    "beforePack": "scripts/before-pack.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0",
      "extraResources": [
        {
          "from": "native/computer-use-macos/bin/${arch}/ConstComputerUse.app",
          "to": "native/computer-use-macos/ConstComputerUse.app"
        }
      ]
    }
  }
}
