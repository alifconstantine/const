{
  "name": "figma",
  "version": "1.0.0",
  "description": "Read Figma designs through the official desktop MCP server, or connect the remote server after Const receives Figma client approval.",
  "author": { "name": "Figma" },
  "interface": { "displayName": "Figma", "icon": "figma" },
  "mcpServers": {
    "figma": {
      "transport": "http",
