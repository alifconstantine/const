{
  "name": "github",
  "version": "1.1.0",
  "description": "Work with GitHub repositories, issues, pull requests, and workflows.",
  "author": {
    "name": "GitHub"
  },
  "interface": {
    "displayName": "GitHub",
    "icon": "github"
  },
  "mcpServers": {
    "github": {
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "oauth",
      "authOptions": [
        "oauth",
        "api-key"
      ],
      "setupUrl": "https://github.com/apps/const-harness/installations/new"
    }
  }
}
