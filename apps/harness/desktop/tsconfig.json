{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@const/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@const/ui": ["../../../packages/ui/src/index.ts"],
      "@const/ui/*": ["../../../packages/ui/src/*"],
      "@const/agent": ["../../../packages/agent/dist/index.d.ts"],
      "@const/agent/*": ["../../../packages/agent/dist/*.d.ts"],
      "@const/ai": ["../../../packages/ai/dist/index.d.ts"],
      "@const/ai/*": ["../../../packages/ai/dist/*.d.ts"],
      "@const/coding-agent": ["../../../packages/coding-agent/dist/index.d.ts"],
      "@const/coding-agent/*": ["../../../packages/coding-agent/dist/*.d.ts"],
      "@const/backend/_generated/*": ["../../../packages/backend/convex/_generated/*"],
      "@const/backend/*": ["../../../packages/backend/convex/*"]
    }
  },
  "include": ["src", "electron"]
}
