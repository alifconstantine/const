# Convex Deployment URL
NEXT_PUBLIC_CONVEX_URL=

# GitHub connector (server-only; never prefix these with NEXT_PUBLIC_).
# Generate a new secret in GitHub and enter it in the Accounts deployment dashboard.
GITHUB_APP_ID=5490453
GITHUB_APP_CLIENT_ID=Iv23liQNAsFijYvpvsTt
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=const-harness
GITHUB_OAUTH_ORIGIN=https://accounts.const.web.id

# Google Workspace connector OAuth (a separate Web application client from Const sign-in).
# Authorized redirect URI: https://accounts.const.web.id/oauth/google/callback
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
GOOGLE_CONNECTOR_ORIGIN=https://accounts.const.web.id
