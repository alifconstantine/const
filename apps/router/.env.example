# Same random server-only value (32+ characters) on Router and Convex. Never NEXT_PUBLIC.
ROUTER_GATEWAY_SECRET=

# QRIS runs on Convex. Configure SUMOPOD_* in the Convex deployment, see PAYMENTS.md.
