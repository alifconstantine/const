# Convex Deployment URL
NEXT_PUBLIC_CONVEX_URL=

# Const Accounts (SSO Hub) URL
NEXT_PUBLIC_ACCOUNTS_URL=

# Const Router App URL
NEXT_PUBLIC_APP_URL=

# Const Engine (OmniRoute Bridge)
CONST_ENGINE_BASE_URL=
