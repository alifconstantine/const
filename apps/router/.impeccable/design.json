  "components": [
    {
      "name": "Public primary action",
      "kind": "button",
      "refersTo": "public-button-primary",
      "description": "Public integration and entry action.",
      "html": "<button class=\"ds-public-primary\">Open console</button>",
      "css": ".ds-public-primary{font-family:var(--font-sans, Manrope),sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:48px;background:var(--rp-text,#f4f1eb);color:var(--rp-bg,#09090b);border:0;border-radius:6px;padding:12px 21px;font-size:14px;font-weight:600;cursor:pointer;transition:background .18s,color .18s}.ds-public-primary:hover{background:var(--rp-accent,#cfbd9c)}.ds-public-primary:focus-visible{outline:2px solid var(--rp-accent,#cfbd9c);outline-offset:5px}"
    },
    {
      "name": "Console primary action",
      "kind": "button",
      "refersTo": "console-button-primary",
      "description": "Compact semantic primary action used in working screens.",
      "html": "<button class=\"ds-button ds-primary\">Save changes</button>",
      "css": ".ds-button{font-family:var(--font-sans, Manrope),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:var(--radius,.75rem);height:2.5rem;padding:.5rem 1.25rem;font-size:.75rem;line-height:1rem;font-weight:500;cursor:pointer;transition:all 200ms;}.ds-primary{background:hsl(var(--primary));color:hsl(var(--primary-foreground));border:1px solid transparent}.ds-primary:hover{background:hsl(var(--primary)/.9)}.ds-button:focus-visible{outline:none;box-shadow:0 0 0 1px hsl(var(--background)),0 0 0 3px hsl(var(--ring))}.ds-button:active{transform:scale(.98)}.ds-button:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Console outline action",
      "kind": "button",
      "refersTo": "console-button-outline",
      "description": "Secondary account or workspace action.",
      "html": "<button class=\"ds-button ds-outline\">Reset defaults</button>",
      "css": ".ds-button{font-family:var(--font-sans, Manrope),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:var(--radius,.75rem);height:2.5rem;padding:.5rem 1.25rem;font-size:.75rem;line-height:1rem;font-weight:500;cursor:pointer;transition:all 200ms;}.ds-outline{border:1px solid hsl(var(--border));background:hsl(var(--background));color:hsl(var(--foreground))}.ds-outline:hover{background:hsl(var(--secondary));color:hsl(var(--foreground))}.ds-button:focus-visible{outline:none;box-shadow:0 0 0 1px hsl(var(--background)),0 0 0 3px hsl(var(--ring))}.ds-button:active{transform:scale(.98)}.ds-button:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Catalog search",
      "kind": "input",
      "refersTo": "catalog-search",
      "description": "The catalog search field with its icon inset.",
      "html": "<div class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search models\" placeholder=\"Search model name or ID…\" /></div>",
      "css": ".ds-search{position:relative}.ds-search svg{position:absolute;left:12px;top:12px;width:16px;height:16px;color:hsl(var(--muted-foreground));pointer-events:none}.ds-search input{font-family:var(--font-sans, Manrope),sans-serif;width:100%;height:40px;border:1px solid hsl(var(--border)/.7);border-radius:1rem;background:hsl(var(--card));padding:8px 16px 8px 36px;color:hsl(var(--foreground));font-size:14px;transition:color 150ms,background-color 150ms,border-color 150ms}.ds-search input::placeholder{color:hsl(var(--muted-foreground))}.ds-search input:hover{border-color:hsl(var(--foreground)/.3)}.ds-search input:focus-visible{outline:none;border-color:hsl(var(--foreground)/.4);box-shadow:inset 0 0 0 1px hsl(var(--foreground)/.15)}.ds-search input:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Console panel",
      "kind": "card",
      "refersTo": "console-panel",
      "description": "Bordered resting work area used by Overview and data groups.",
      "html": "<section class=\"ds-panel\"><h2>Usage</h2><p>Request and token activity</p></section>",
      "css": ".ds-panel{font-family:var(--font-sans, Manrope),sans-serif;background:hsl(var(--card));color:hsl(var(--card-foreground));border:1px solid hsl(var(--border));border-radius:var(--radius,.75rem);padding:20px}.ds-panel h2{font-size:14px;font-weight:500;margin:0}.ds-panel p{font-size:12px;line-height:20px;color:hsl(var(--muted-foreground));margin:8px 0 0}@media(min-width:640px){.ds-panel{padding:24px}}"
    },
    {
      "name": "Catalog category",
      "kind": "chip",
      "refersTo": "category-selected",
      "description": "Pressed category filter with a quiet secondary surface.",
      "html": "<button class=\"ds-category\" aria-pressed=\"true\">All</button><button class=\"ds-category\" aria-pressed=\"false\">Chat</button>",
      "css": ".ds-category{font-family:var(--font-sans, Manrope),sans-serif;border:0;border-radius:calc(var(--radius,.75rem) - 2px);padding:8px 12px;font-size:12px;line-height:16px;background:transparent;color:hsl(var(--muted-foreground));cursor:pointer;transition:color 150ms,background-color 150ms}.ds-category[aria-pressed=\"true\"]{background:hsl(var(--secondary));color:hsl(var(--foreground))}.ds-category:hover{color:hsl(var(--foreground))}.ds-category:focus-visible{outline:2px solid hsl(var(--ring));outline-offset:3px}"
    },
