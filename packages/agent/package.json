{
	"name": "@const/agent",
	"version": "0.84.2",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./models": {
			"types": "./src/const/models.ts",
			"import": "./src/const/models.ts"
		},
		"./types": {
			"types": "./src/const/types.ts",
			"import": "./src/const/types.ts"
		},
		"./mutation-ledger": {
			"types": "./src/const/mutation-ledger.ts",
			"import": "./src/const/mutation-ledger.ts"
		},
		"./node": {
			"types": "./src/node.ts",
			"import": "./src/node.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-telemetry-docs": "node scripts/generate-telemetry-docs.ts",
		"check:telemetry-docs": "node scripts/generate-telemetry-docs.ts --check",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"test:harness": "vitest --run --config vitest.harness.config.ts",
		"coverage:harness": "vitest --run --config vitest.harness.config.ts --coverage",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@const/ai": "workspace:*",
		"@const/telemetry": "workspace:*",
		"@types/pdf-parse": "^1.1.5",
		"diff": "8.0.4",
		"ignore": "7.0.5",
		"pdf-parse": "^2.4.5",
		"typebox": "1.3.7",
		"yaml": "2.9.0"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Const",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alifconstantine/const.git",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@vitest/coverage-v8": "4.1.9",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
